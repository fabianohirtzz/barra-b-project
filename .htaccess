# Barra Boat Floripa: regras do servidor (ErêHost, Apache/LiteSpeed)

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /site.php

RewriteEngine On

# Domínio oficial: sempre https://barraboatfloripa.com.br (sem www), como no canonical
RewriteCond %{HTTP_HOST} ^www\.barraboatfloripa\.com\.br$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^(www\.)?barraboatfloripa\.com\.br$ [NC]
RewriteRule ^(.*)$ https://barraboatfloripa.com.br/$1 [R=301,L]

# Endereços do WordPress antigo que não existem mais (as lanchas e páginas mantêm o mesmo endereço)
RewriteRule ^(reembolso-ou-devolucoes|refund_returns)(/.*)?$ /politica-de-cancelamento/ [R=301,L,NC]
RewriteRule ^privacy-policy(/.*)?$ /politica-de-privacidade/ [R=301,L,NC]
RewriteRule ^produto/([a-z0-9-]+)/?$ /lanchas/$1/ [R=301,L,NC]
RewriteRule ^(shop|loja|categoria-produto|produto-tag|passageiro|pes|valor)(/.*)?$ /lanchas/ [R=301,L,NC]
RewriteRule ^(carrinho|cart|finalizar-compra|checkout|minha-conta|my-account|feed|comments)(/.*)?$ / [R=301,L,NC]
RewriteRule ^(sitemap_index|[a-z_]+-sitemap[0-9]*)\.xml$ /sitemap.xml [R=301,L,NC]

# Login do painel chega ao PHP (api/agenda.php): alguns servidores descartam o cabeçalho
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Código e cache do servidor não são servidos pela web
RewriteRule ^(lib|cache|cron|traducoes)(/|$) - [F,L]

# Pasta das fotos enviadas pelo painel: só imagem, nunca código
RewriteRule ^(fotos|midia)/.*\.(php[0-9]?|phtml|phar|cgi|pl|py|sh)$ - [F,L,NC]
# Vídeos ainda na fila (originais do celular) não são servidos
RewriteRule ^midia/instagram/fila(/|$) - [F,L]

# Sitemap com as lanchas ativas no painel, nos 9 idiomas
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^llms\.txt$ llms.php [L]

# Site em outros idiomas (/es/, /en/...): arquivos de assets, fotos, mídia e api são os mesmos da raiz
RewriteRule ^(?:es|en|fr|de|it|nl|ja|zh)/((?:assets|fotos|midia|api)/.*|favicon\.ico)$ $1 [L]
RewriteRule ^(es|en|fr|de|it|nl|ja|zh)$ /$1/ [R=301,L]

# Páginas (pastas com index.html) são montadas pelo site.php com os dados do banco:
# "/", "/lanchas/", "/lanchas/<slug>/", "/sobre/"... O painel e a api ficam de fora.
RewriteCond %{REQUEST_URI} !^/(painel|api|assets)/
RewriteRule ^((?:[a-z0-9-]+/){0,3})$ site.php?p=$1 [L,QSA]

# Segredos do servidor nunca são servidos
<FilesMatch "^(config\.local\.php|\.publicado\.json)$">
  Require all denied
</FilesMatch>

# Prévia em novo.barraboatfloripa.com.br: fora do Google até a troca
<If "%{HTTP_HOST} =~ /^(www\.)?novo\./">
  Header set X-Robots-Tag "noindex, nofollow"
</If>
